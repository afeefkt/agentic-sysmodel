{
  "$schema": "https://opencode.ai/config.json",

  "provider": {
    "deepseek": {
      "models": {
        "deepseek-flash":  { "name": "DeepSeek Flash",   "limit": { "context": 1000000, "output": 32000 } },
        "deepseek-v4-pro": { "name": "DeepSeek V4 Pro",  "limit": { "context": 1000000, "output": 32000 } }
      }
    }
  },

  "model": "deepseek/deepseek-v4-pro",
  "small_model": "deepseek/deepseek-flash",
  "default_agent": "sysarch",

  "mcp": {
    "freecad": {
      "type": "local",
      "command": ["uv", "run", "--directory", "../external/freecad-mcp", "freecad-mcp", "--only-text-feedback"],
      "enabled": true,
      "timeout": 60000
    },
    "openmodelica": {
      "type": "local",
      "command": ["uv", "run", "--directory", "tools/om_mcp", "python", "server.py"],
      "enabled": true,
      "timeout": 60000
    }
  },

  "tools": {
    "freecad_*": false,
    "openmodelica_*": false
  },

  "agent": {
    "sysarch": {
      "description": "System architect and orchestrator. Plans the modeling project, delegates to subagents, tracks requirements-to-evidence state. Start here.",
      "mode": "primary",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.3,
      "prompt": "{file:./agents/prompts/sysarch.md}",
      "tools": {
        "openmodelica_describe_class": true,
        "openmodelica_search_library": true,
        "openmodelica_list_examples": true
      },
      "permission": { "edit": "allow", "bash": "ask" }
    },

    "req-engineer": {
      "description": "Turns a system need into measurable, verifiable requirements (requirements.yaml with REQ IDs, acceptance criteria, verification cases).",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "temperature": 0.3,
      "prompt": "{file:./agents/prompts/req-engineer.md}",
      "tools": { "task": false },
      "permission": { "edit": "allow", "bash": "deny" }
    },

    "cad-designer": {
      "description": "Builds parametric parts/assemblies in FreeCAD via MCP and exports mass properties and joint frames (SI units) for Modelica.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "temperature": 0.3,
      "prompt": "{file:./agents/prompts/cad-designer.md}",
      "tools": { "task": false, "freecad_*": true, "freecad_execute_code_headless": false },
      "permission": { "edit": "allow", "bash": "deny" }
    },

    "modelica-modeler": {
      "description": "Builds component-based Modelica models (MSL components wired with connect(), placed for the OMEdit diagram) from the architecture and CAD data; must pass check, smoke simulation and diagram_check before handing back.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "prompt": "{file:./agents/prompts/modelica-modeler.md}",
      "tools": {
        "task": false,
        "openmodelica_check": true,
        "openmodelica_describe_class": true,
        "openmodelica_search_library": true,
        "openmodelica_list_examples": true,
        "openmodelica_get_class_source": true,
        "openmodelica_diagram_check": true,
        "openmodelica_simulate": true,
        "openmodelica_list_variables": true,
        "openmodelica_read_results": true
      },
      "permission": { "edit": "allow", "bash": "deny" }
    },

    "design-tuner": {
      "description": "Sizes/tunes design PARAMETERS (never model structure) with simulation sweeps until requirements pass; logs every iteration.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "prompt": "{file:./agents/prompts/design-tuner.md}",
      "tools": {
        "task": false,
        "openmodelica_simulate": true,
        "openmodelica_read_results": true,
        "openmodelica_time_to_reach": true,
        "openmodelica_verify": true,
        "openmodelica_list_variables": true
      },
      "permission": { "edit": "allow", "bash": "deny" }
    },

    "sim-verifier": {
      "description": "Independent verification: runs nominal and edge-case simulations, evaluates every requirement, writes the PASS/FAIL verification report. Never edits models.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "temperature": 0.1,
      "prompt": "{file:./agents/prompts/sim-verifier.md}",
      "tools": {
        "task": false,
        "openmodelica_check": true,
        "openmodelica_diagram_check": true,
        "openmodelica_simulate": true,
        "openmodelica_read_results": true,
        "openmodelica_time_to_reach": true,
        "openmodelica_verify": true,
        "openmodelica_list_variables": true,
        "openmodelica_measure": true,
        "openmodelica_compare_cases": true,
        "openmodelica_plot": true,
        "openmodelica_export_data": true
      },
      "permission": { "edit": "allow", "bash": "deny" }
    },

    "control-expert": {
      "description": "Control systems engineer: designs controllers, sequencing/mode logic, limiters and filters in the Controls sub-package; uses linearization, stability margins and nonlinear metrics across edge cases. Never edits plant physics.",
      "mode": "subagent",
      "model": "deepseek/deepseek-v4-pro",
      "temperature": 0.1,
      "prompt": "{file:./agents/prompts/control-expert.md}",
      "tools": {
        "task": false,
        "openmodelica_check": true,
        "openmodelica_describe_class": true,
        "openmodelica_search_library": true,
        "openmodelica_list_examples": true,
        "openmodelica_get_class_source": true,
        "openmodelica_diagram_check": true,
        "openmodelica_simulate": true,
        "openmodelica_read_results": true,
        "openmodelica_list_variables": true,
        "openmodelica_time_to_reach": true,
        "openmodelica_measure": true,
        "openmodelica_compare_cases": true,
        "openmodelica_linearize": true,
        "openmodelica_frequency_analysis": true
      },
      "permission": { "edit": "allow", "bash": "deny" }
    },

    "data-analyst": {
      "description": "Measures, compares, plots and exports existing simulation results on request (metrics like overshoot/settling/peak/rms, case comparison tables, PNG plots, CSV/Excel). Never simulates new designs or edits models.",
      "mode": "subagent",
      "model": "deepseek/deepseek-flash",
      "temperature": 0.1,
      "prompt": "{file:./agents/prompts/data-analyst.md}",
      "tools": {
        "task": false,
        "openmodelica_list_variables": true,
        "openmodelica_read_results": true,
        "openmodelica_time_to_reach": true,
        "openmodelica_measure": true,
        "openmodelica_compare_cases": true,
        "openmodelica_plot": true,
        "openmodelica_export_data": true
      },
      "permission": { "edit": "deny", "bash": "deny" }
    }
  }
}
